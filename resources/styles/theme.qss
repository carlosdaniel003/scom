* {
    font-family: "Segoe UI", "Arial";
    font-size: 13px;
    color: #dce9f7;
    outline: none;
}

QMainWindow,
QWidget#applicationShell,
QWidget#contentArea,
QStackedWidget {
    background: #07111d;
}

QToolTip {
    background: #10263a;
    color: #f2f8ff;
    border: 1px solid #2d6187;
    border-radius: 6px;
    padding: 7px 9px;
}

/* Estrutura principal */
#sidebar {
    background: #081724;
    border-right: 1px solid #17344c;
}

#brandIcon {
    background: #0f2b42;
    border: 1px solid #1f557a;
    border-radius: 12px;
}

#brandTitle {
    color: #56baff;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: 2px;
}

#brandKicker,
#topbarKicker,
#sidebarSectionLabel {
    color: #6387a5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

#brandSubtitle,
#sidebarFooter,
#pageSubtitle,
#mutedText,
#sectionSubtitle,
#statHelper {
    color: #7898b3;
}

#brandSubtitle {
    font-size: 11px;
    padding-top: 8px;
}

#sidebarSectionLabel {
    padding: 0 10px 5px 10px;
}

#navButton {
    min-height: 48px;
    padding: 0 14px;
    text-align: left;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: #91a9bd;
    font-weight: 600;
}

#navButton:hover {
    background: #0d263b;
    color: #eaf6ff;
    border-color: #173f5d;
}

#navButton:checked {
    background: #123b5b;
    color: #70c8ff;
    border-color: #287caf;
}

#environmentCard {
    background: #0a1c2b;
    border: 1px solid #183950;
    border-radius: 10px;
}

#environmentTitle {
    color: #a9c5d9;
    font-size: 11px;
    font-weight: 600;
}

#statusDot {
    color: #44d7a8;
    font-size: 11px;
}

#sidebarFooter {
    font-size: 10px;
}

/* Barra superior */
#topbar {
    background: #091927;
    border-bottom: 1px solid #17354d;
}

#topbarPageTitle {
    color: #edf7ff;
    font-size: 16px;
    font-weight: 700;
}

#toggleLabel {
    color: #8ca8bc;
    font-size: 11px;
    font-weight: 600;
}

QCheckBox#toggleSwitch {
    spacing: 0;
}

QCheckBox#toggleSwitch::indicator {
    width: 42px;
    height: 23px;
    image: url(resources/icons/toggle-off.svg);
}

QCheckBox#toggleSwitch::indicator:checked {
    image: url(resources/icons/toggle-on.svg);
}

#dateTimePanel {
    background: #0d2233;
    border: 1px solid #1d425d;
    border-radius: 10px;
}

#dateTimeIcon {
    color: #58bdff;
}

#timeLabel {
    color: #eaf7ff;
    font-size: 14px;
    font-weight: 700;
}

#dateLabel {
    color: #7394ac;
    font-size: 10px;
}

#iconButton {
    background: #0d2233;
    border: 1px solid #1d425d;
    border-radius: 10px;
    padding: 0;
}

#iconButton:hover {
    background: #13314a;
    border-color: #2a719e;
}

#iconButton:pressed {
    background: #0a1b29;
}

/* Hierarquia de páginas */
#pageTitle {
    color: #f0f7fd;
    font-size: 29px;
    font-weight: 750;
}

#pageSubtitle {
    font-size: 13px;
}

#sectionTitle,
#dialogTitle {
    color: #eaf5ff;
    font-size: 16px;
    font-weight: 700;
}

#sectionSubtitle {
    font-size: 11px;
}

#liveStatusChip {
    background: #0d2c2a;
    border: 1px solid #1c6057;
    border-radius: 9px;
    color: #69ddbd;
    font-size: 10px;
    font-weight: 700;
    padding: 7px 11px;
}

/* Indicadores */
QFrame#statCard,
QFrame#warningCard,
QFrame#dangerCard {
    background: #0c1d2c;
    border: 1px solid #1a3d57;
    border-radius: 13px;
}

QFrame#statCard:hover {
    background: #0f2436;
    border-color: #286287;
}

QFrame#warningCard {
    border-color: #705b2c;
    background: #161f26;
}

QFrame#warningCard:hover {
    border-color: #9b7b32;
}

QFrame#dangerCard {
    border-color: #6f3543;
    background: #181c27;
}

QFrame#dangerCard:hover {
    border-color: #9a4558;
}

#statIconBadge {
    background: #102d43;
    border: 1px solid #205b7e;
    border-radius: 10px;
}

#warningCard #statIconBadge {
    background: #302b1d;
    border-color: #6f5b2c;
}

#dangerCard #statIconBadge {
    background: #30202a;
    border-color: #6e3543;
}

#statValue {
    color: #61c2ff;
    font-size: 31px;
    font-weight: 800;
}

#warningCard #statValue {
    color: #f4c95d;
}

#dangerCard #statValue {
    color: #ff748b;
}

#statTitle {
    color: #b8cad8;
    font-size: 12px;
    font-weight: 650;
}

#statHelper {
    font-size: 10px;
}

/* Painéis */
QFrame#formPanel,
QFrame#imagePanel,
QFrame#activityPanel {
    background: #0a1a29;
    border: 1px solid #173a54;
    border-radius: 12px;
}

#activityPanel {
    border-radius: 13px;
}

#sectionHeader {
    background: #0c2031;
    border: none;
    border-bottom: 1px solid #183e59;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

#sectionIcon {
    background: #10334a;
    border: 1px solid #245e80;
    border-radius: 9px;
    color: #62c2fc;
    font-size: 18px;
    font-weight: 700;
}

/* Campos */
QLineEdit,
QTextEdit,
QComboBox,
QSpinBox {
    background: #091725;
    border: 1px solid #21445f;
    border-radius: 8px;
    padding: 9px 11px;
    selection-background-color: #176fae;
    color: #e5f1fc;
}

QLineEdit:hover,
QTextEdit:hover,
QComboBox:hover,
QSpinBox:hover {
    border-color: #2d5e80;
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #3ca9ed;
    background: #0b1d2d;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background: #0c1d2f;
    border: 1px solid #29577f;
    selection-background-color: #145587;
}

/* Botões */
QPushButton {
    background: #15344e;
    border: 1px solid #2b5c7d;
    border-radius: 8px;
    padding: 8px 13px;
    color: #dceeff;
    font-weight: 600;
}

QPushButton:hover {
    background: #1a466b;
    border-color: #3d8dbc;
}

QPushButton:pressed {
    background: #0f293e;
}

#primaryButton {
    background: #147fbd;
    border-color: #36a7df;
    color: #ffffff;
    padding: 10px 18px;
}

#primaryButton:hover {
    background: #1798db;
}

#secondaryButton {
    background: transparent;
}

#successButton {
    background: #12513f;
    border-color: #267a60;
    color: #bafbe5;
}

#successButton:hover {
    background: #17684f;
}

#dangerButton {
    background: #572530;
    border-color: #843e4c;
    color: #ffd5dd;
}

#dangerButton:hover {
    background: #74303e;
}

#filterButton {
    background: #0d2031;
    border-color: #244a68;
    color: #8faabe;
}

#filterButton:hover {
    color: #dceeff;
}

#filterButton:checked {
    background: #145c8c;
    border-color: #3b9ed6;
    color: #ffffff;
}

#searchInput {
    min-height: 25px;
    padding-left: 13px;
}

/* Tabelas */
QTableWidget {
    background: #091825;
    alternate-background-color: #0b1c2b;
    border: 1px solid #183a54;
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: #124f79;
    selection-color: #ffffff;
}

QTableWidget#dashboardTable {
    border: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #102d42;
}

QTableWidget::item:hover {
    background: #102a3e;
}

QHeaderView::section {
    background: #10283b;
    color: #9ec1d9;
    padding: 11px 10px;
    border: none;
    border-right: 1px solid #1b405a;
    border-bottom: 1px solid #2a5a79;
    font-size: 11px;
    font-weight: 700;
}

QTableCornerButton::section {
    background: #10283b;
    border: none;
}

QScrollBar:vertical {
    background: #07131f;
    width: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #255675;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #34759b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #07131f;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #255675;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Imagens e detalhes */
#imagePreview {
    background: #07131f;
    border: 1px dashed #315d7d;
    border-radius: 9px;
    color: #7894ae;
    padding: 10px;
}

#detailKey {
    color: #7f9ebc;
    font-weight: 700;
}

#detailValue {
    color: #e0edf8;
}

QMessageBox,
QDialog {
    background: #0a1827;
}
