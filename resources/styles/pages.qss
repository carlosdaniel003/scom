/* Componentes compartilhados das páginas internas */
#pageHeaderIconBadge {
    background: #0f2f46;
    border: 1px solid #245f82;
    border-radius: 12px;
}

#pageChip {
    background: #0c2638;
    border: 1px solid #23506d;
    border-radius: 9px;
    color: #75caff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 7px 11px;
}

QFrame#toolbarPanel,
QFrame#dataPanel,
QFrame#actionBar {
    background: #0a1a29;
    border: 1px solid #173a54;
    border-radius: 12px;
}

QFrame#toolbarPanel {
    background: #0b1d2c;
}

#toolbarLabel {
    color: #6689a3;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 0 3px 0 8px;
}

#resultBadge {
    background: #102d43;
    border: 1px solid #255b7a;
    border-radius: 8px;
    color: #7ecfff;
    font-size: 10px;
    font-weight: 700;
    padding: 6px 10px;
}

#panelSectionHeader {
    background: #0c2031;
    border: none;
    border-bottom: 1px solid #183e59;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
}

#panelSectionIconBadge {
    background: #10334a;
    border: 1px solid #245e80;
    border-radius: 9px;
}

#panelSectionTitle {
    color: #eaf5ff;
    font-size: 15px;
    font-weight: 700;
}

#panelSectionSubtitle {
    color: #7696ae;
    font-size: 10px;
}

QTableWidget#inventoryTable,
QTableWidget#movementsTable {
    border: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

#tableActions {
    background: transparent;
}

#tableActionButton {
    background: #102b40;
    border-color: #285876;
    padding: 7px 10px;
}

#tableActionButton:hover {
    background: #174462;
    border-color: #3b87b0;
}

/* Área de proteção, importação e exportação */
QFrame#backupActionsPanel {
    background: #0a1c2b;
    border: 1px solid #1c4561;
    border-radius: 12px;
}

QFrame#backupActionsPanel:hover {
    background: #0c2132;
    border-color: #276486;
}

#backupKicker {
    color: #61c5ff;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 1px;
}

#backupTitle {
    color: #eaf5ff;
    font-size: 15px;
    font-weight: 700;
}

#backupSubtitle {
    color: #7898b1;
    font-size: 10px;
}

#backupSafetyChip {
    background: #2a2416;
    border: 1px solid #6d5a29;
    border-radius: 8px;
    color: #f2cd73;
    font-size: 9px;
    font-weight: 700;
    padding: 6px 9px;
}

QPushButton#backupImportButton,
QPushButton#backupPrimaryButton,
QPushButton#backupSecondaryButton {
    min-height: 43px;
    border-radius: 9px;
    padding: 0 14px;
    font-size: 11px;
    font-weight: 700;
    text-align: left;
}

QPushButton#backupImportButton {
    background: #302817;
    border: 1px solid #80672d;
    color: #ffe5a6;
}

QPushButton#backupImportButton:hover {
    background: #41351d;
    border-color: #b18a38;
}

QPushButton#backupImportButton:pressed {
    background: #261f13;
}

QPushButton#backupPrimaryButton {
    background: #147fbd;
    border: 1px solid #3aa9df;
    color: #ffffff;
}

QPushButton#backupPrimaryButton:hover {
    background: #1798db;
    border-color: #69c7f2;
}

QPushButton#backupPrimaryButton:pressed {
    background: #0f6b9e;
}

QPushButton#backupSecondaryButton {
    background: #102b40;
    border: 1px solid #2b6385;
    color: #d9efff;
}

QPushButton#backupSecondaryButton:hover {
    background: #174462;
    border-color: #48a0cc;
}

QPushButton#backupSecondaryButton:pressed {
    background: #0c2638;
}

/* Paginação */
QWidget#paginationBar {
    background: #0b1d2c;
    border-top: 1px solid #173a54;
}

#paginationSummary {
    color: #7597b0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QPushButton#paginationButton {
    background: #10283b;
    border: 1px solid #28506c;
    border-radius: 7px;
    color: #9ebbd0;
    padding: 0;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#paginationButton:hover {
    background: #17415e;
    border-color: #3b86af;
    color: #edf8ff;
}

QPushButton#paginationButton:checked {
    background: #147fbd;
    border-color: #46b1e7;
    color: #ffffff;
}

QPushButton#paginationButton:disabled {
    background: #0a1925;
    border-color: #183246;
    color: #425e72;
}

/* Indicadores compactos de movimentação */
QFrame#compactMetric,
QFrame#compactMetricSuccess,
QFrame#compactMetricDanger {
    background: #0c1d2c;
    border: 1px solid #1a3d57;
    border-radius: 12px;
}

QFrame#compactMetric:hover,
QFrame#compactMetricSuccess:hover,
QFrame#compactMetricDanger:hover {
    background: #0f2436;
}

QFrame#compactMetricSuccess {
    border-color: #276150;
}

QFrame#compactMetricDanger {
    border-color: #713845;
}

#compactMetricIconBadge {
    background: #102f45;
    border: 1px solid #245f80;
    border-radius: 10px;
}

#compactMetricSuccess #compactMetricIconBadge {
    background: #12342c;
    border-color: #286854;
}

#compactMetricDanger #compactMetricIconBadge {
    background: #34202a;
    border-color: #713947;
}

#compactMetricValue {
    color: #65c5ff;
    font-size: 23px;
    font-weight: 800;
}

#compactMetricSuccess #compactMetricValue {
    color: #6ee7b7;
}

#compactMetricDanger #compactMetricValue {
    color: #ff8093;
}

#compactMetricTitle {
    color: #89a5ba;
    font-size: 11px;
    font-weight: 600;
}

/* Cadastro de peças */
QScrollArea#pageScroll {
    background: transparent;
    border: none;
}

QScrollArea#pageScroll > QWidget > QWidget {
    background: transparent;
}

#fieldLabel {
    color: #a8bfd0;
    font-size: 11px;
    font-weight: 650;
    min-width: 145px;
}

#fieldHint {
    color: #6889a2;
    font-size: 10px;
}

#formSection {
    background: transparent;
}

#formSectionTitle {
    color: #69c5fa;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 1px;
}

#formSectionLine {
    background: #183950;
    border: none;
    max-height: 1px;
}

#imageActionButton {
    background: #13466a;
    border-color: #2b79a5;
    color: #eaf7ff;
}

#imageActionButton:hover {
    background: #185b87;
    border-color: #42a1d0;
}

#actionBar {
    background: #0c2030;
}

#requiredHint {
    color: #7f9db4;
    font-size: 10px;
}

QFrame#imagePanel,
QFrame#formPanel {
    background: #0a1a29;
}

QFrame#imagePanel #panelSectionHeader,
QFrame#formPanel #panelSectionHeader {
    border-bottom-color: #1b425d;
}
